{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Flask Dev Server (app.py)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app.py"],
      "port": 5000
    },
    {
      "name": "Waitress Production",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "waitress", "--host=0.0.0.0", "--port=8000", "app:app"],
      "port": 8000
    }
  ]
}
